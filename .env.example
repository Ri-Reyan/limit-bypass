# Server Environment
PORT=3000
NODE_ENV=development

# Service Authentication (Bearer Token)
API_KEY=your_secure_api_key_secret_min_16_chars

# CORS Configuration (comma-separated list of allowed origins, or * for all)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# SMTP Provider Credentials
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password_here

# Default Email Sender Header (e.g., "Company Name <no-reply@domain.com>")
MAIL_FROM="Acme Notification <no-reply@yourdomain.com>"

